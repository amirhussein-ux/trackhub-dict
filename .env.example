# Backend (server-only secrets)
MONGODB_URL="mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority"
AUTH_SESSION_SECRET="replace-with-a-long-random-secret"
SEED_ADMIN_PASSWORD="replace-with-strong-password"
SEED_DIVISION_CHIEF_PASSWORD="replace-with-strong-password"
SEED_DIVISION_MEMBER_PASSWORD="replace-with-strong-password"

# Backend (non-secret)
PORT="5000"
FRONTEND_URL="http://localhost:8080"

# Frontend (public, safe to expose)
VITE_API_URL="http://localhost:5000/api"