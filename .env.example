# ============================================
# TRACKHUB ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in real values
# DO NOT commit .env file to version control
#
# Instructions:
# 1. For Docker: Use MongoDB service name "mongodb" in MONGODB_URL
# 2. For Local Dev: Use localhost connection
# 3. Generate secure secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ============================================
# BACKEND (Server-only secrets)
# ============================================

# Docker Compose: Use service name
MONGODB_URL="mongodb://admin:changeme@mongodb:27017/trackhub"

# Local Development: Use localhost
# MONGODB_URL="mongodb://127.0.0.1:27017/trackhub"

# Session authentication secret (MUST be 32+ characters)
AUTH_SESSION_SECRET="replace-with-a-long-random-secret-minimum-32-chars-here"

# Default seeded user passwords for initial deployment
SEED_ADMIN_PASSWORD="Admin@12345!"
SEED_DIVISION_CHIEF_PASSWORD="Chief@12345!"
SEED_DIVISION_MEMBER_PASSWORD="Member@12345!"

# ============================================
# BACKEND (Non-secret configuration)
# ============================================

# Application environment
NODE_ENV="production"

# Backend server port
PORT="5000"

# Frontend URL for CORS (Docker: http://localhost, Local: http://localhost:8080)
FRONTEND_URL="http://localhost"

# ============================================
# BACKEND (Optional: Email Configuration)
# ============================================

# Support ticket email configuration (Gmail SMTP)
SUPPORT_EMAIL="trackhub.support@example.com"
SUPPORT_EMAIL_PASSWORD="your-gmail-app-specific-password"

# Password reset emails via Resend (optional)
# Get API key from https://resend.com
RESEND_API_KEY="re_replace_with_your_resend_api_key"
RESEND_FROM_EMAIL="TrackHub Support <noreply@trackhub.gov.ph>"

# ============================================
# FRONTEND (Public/Safe configuration)
# ============================================

# API URL for frontend to call backend
# Docker: Use relative path (nginx proxies to backend)
VITE_API_URL="/api"

# Local Development: Use full backend URL
# VITE_API_URL="http://localhost:5000/api"

# Application environment
VITE_APP_ENV="production"

# Optional: Analytics and error tracking
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_ERROR_TRACKING="false"