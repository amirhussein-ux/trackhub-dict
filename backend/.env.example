# Backend Environment Configuration for TrackHub
# Copy to .env and fill in real values
# DO NOT commit .env file to version control

# ============================================
# DOCKER/PRODUCTION CONFIGURATION
# ============================================
# When using Docker Compose, use:
MONGODB_URL="mongodb://admin:changeme@mongodb:27017/trackhub"

# ============================================
# LOCAL DEVELOPMENT CONFIGURATION
# ============================================
# For local development without Docker, use:
# MONGODB_URL="mongodb://127.0.0.1:27017/trackhub"

# Application Environment
NODE_ENV="production"
PORT="5000"

# Frontend URL for CORS origin
# Docker: http://localhost or http://frontend service
# Local: http://localhost:8080
FRONTEND_URL="http://localhost"

# Session Authentication
# Minimum 32 characters - generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET="replace-with-a-long-random-secret-minimum-32-chars-here"

# Default Seeded User Passwords
SEED_ADMIN_PASSWORD="Admin@12345!"
SEED_DIVISION_CHIEF_PASSWORD="Chief@12345!"
SEED_DIVISION_MEMBER_PASSWORD="Member@12345!"

# Support Email Configuration (Optional)
# Gmail SMTP for Contact & Support feature
SUPPORT_EMAIL="trackhub.customerservice@gmail.com"
SUPPORT_EMAIL_PASSWORD="replace-with-your-gmail-app-password"

# Resend Email Service (Optional - for password reset emails)
# Get API key from https://resend.com
RESEND_API_KEY="replace-with-your-resend-api-key"
# Use a verified sender email in Resend
RESEND_FROM_EMAIL="TrackHub <no-reply@yourdomain.com>"
