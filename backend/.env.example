# Option A: Full URI (replace placeholders)
MONGODB_URL="mongodb+srv://<db_user>:<db_password>@cluster0.ukrtrbj.mongodb.net/?appName=Cluster0"

# Option B: Split credentials (recommended when password contains special characters)
# MONGODB_USERNAME="amirmacakiling_db_user"
# MONGODB_PASSWORD="your-real-db-password"
# MONGODB_HOST="cluster0.ukrtrbj.mongodb.net"
# MONGODB_DATABASE=""
# MONGODB_APP_NAME="Cluster0"

# Local MongoDB alternative
# MONGODB_URL="mongodb://127.0.0.1:27017/trackhub"
AUTH_SESSION_SECRET="replace-with-a-long-random-secret"
SEED_ADMIN_PASSWORD="Admin@12345!"
SEED_DIVISION_CHIEF_PASSWORD="Chief@12345!"
SEED_DIVISION_MEMBER_PASSWORD="Member@12345!"
PORT="5000"
FRONTEND_URL="http://localhost:8080"

# Resend (Forgot Password emails)
# Get API key from https://resend.com
RESEND_API_KEY="replace-with-your-resend-api-key"
# Use a verified sender email in Resend
RESEND_FROM_EMAIL="TrackHub <no-reply@yourdomain.com>"

# Gmail SMTP (Contact & Support)
SUPPORT_EMAIL="trackhub.customerservice@gmail.com"
SUPPORT_EMAIL_PASSWORD="replace-with-your-gmail-app-password"
