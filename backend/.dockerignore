# Backend .dockerignore - Exclude unnecessary files from Docker build context

# Dependencies
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# Build and dist
dist
build
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Git
.git
.gitignore
.gitattributes

# Version control
.hg
.svn

# IDE and editors
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
*.iml

# Testing
coverage
.nyc_output
jest.config.js
vitest.config.ts

# Logs
logs
*.log

# Runtime
tmp
temp

# Docker files (not needed in build)
Dockerfile
docker-compose.yml
.dockerignore

# Documentation
README.md
CHANGELOG.md
docs

# CI/CD
.github
.gitlab-ci.yml
.circleci

# Package manager locks (only if using npm ci)
# package-lock.json
# yarn.lock
